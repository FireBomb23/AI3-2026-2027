# Copiar para .env e preencher.
# Mínimo de 32 caracteres aleatórios. Gerar, por exemplo, com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=
# Validade dos tokens, em segundos (900 por omissão)
JWT_VALIDADE=900
# Para testes: destrói a resposta da primeira criação de cada Idempotency-Key.
SIMULAR_PERDA_RESPOSTA=0
# Para testes: devolve 503 nos próximos N POST /v2/sugestoes.
SIMULAR_503=0
